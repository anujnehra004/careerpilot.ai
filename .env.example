# ==============================================================================
# CareerPilot AI - Environment Configuration Example
# Copy this file to `backend/.env` and update the values with your credentials.
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Google Gemini API
# Get your official API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Supabase PostgreSQL & Auth Credentials
# Get your project URL and keys from https://supabase.com/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Optional: Frontend Environment Variables (in frontend/.env)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
